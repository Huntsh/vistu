# ─── Supabase (banco de dados) ───────────────────────────────────────────────
# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (SECRETA — nunca vai para o navegador, só para o servidor)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Acesso ao app ───────────────────────────────────────────────────────────
# String aleatória longa: assina o cookie de sessão e o hash das senhas.
# Gere uma com:  openssl rand -hex 32
# (trocar depois desconecta todo mundo e invalida os logins)
AUTH_SECRET=

# E-mail que vira ADMINISTRADOR no primeiro login (quando a tabela accounts
# ainda está vazia). Deixe igual ao seu e-mail.
ADMIN_EMAIL=voce@exemplo.com
# Senha inicial desse admin — usada só nessa primeira vez.
APP_PASSWORD=troque-esta-senha
