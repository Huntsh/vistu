# ─── Supabase (banco de dados) ───────────────────────────────────────────────
# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (SECRETA — nunca vai para o navegador, só para o servidor)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Acesso ao app ───────────────────────────────────────────────────────────
# Senha única que você digita para entrar (celular e computador usam a mesma)
APP_PASSWORD=troque-esta-senha

# String aleatória longa para assinar o cookie de login.
# Gere uma com:  openssl rand -hex 32
AUTH_SECRET=
